# ==============================================================================
# Computer Networks Virtual Lab (CN-VLab) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your actual .env.local file to version control.

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# For local development, connect to your dedicated Neon development branch.
# Example: postgresql://neondb_owner:password@ep-your-dev-branch.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<dev-branch-endpoint>.aws.neon.tech/neondb?sslmode=require

# SAFETY GUARD: Strict development isolation check (Required by lib/db.js)
# DATABASE_ENV must be set to 'development' locally.
DATABASE_ENV=development

# In development, DEV_DATABASE_URL MUST exactly match DATABASE_URL.
# lib/db.js verifies this match to strictly prevent accidental writes to production.
DEV_DATABASE_URL=postgresql://<user>:<password>@<dev-branch-endpoint>.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentication & Session Secrets
# ------------------------------------------------------------------------------
# Generate a unique random secret for local JWT signing (do NOT use production secrets)
JWT_SECRET=dev_jwt_secret_change_me_for_local_testing_2026

# Faculty registration authorization key
FACULTY_SECRET=dev_faculty_secret_key_2026

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
ALLOWED_ORIGIN=*
